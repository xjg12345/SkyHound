<?xml version="1.0"?>
<sdf version="1.6">
  <world name="quadruped_demo">
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.7 0.8 0.9 1</background></scene>
    <light name="sun" type="directional"><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.2 -1</direction></light>
    <physics name="ode" type="ode"><max_step_size>0.002</max_step_size><real_time_update_rate>500</real_time_update_rate></physics>
    <model name="ground">
      <static>true</static>
      <link name="ground">
        <collision name="ground"><geometry><plane><normal>0 0 1</normal><size>20 16</size></plane></geometry></collision>
        <visual name="ground"><geometry><plane><normal>0 0 1</normal><size>20 16</size></plane></geometry></visual>
      </link>
    </model>
    <model name="map_obstacles">
      <static>true</static>
      <link name="boxes">
        <collision name="center"><pose>0 0 0.50 0 0 0</pose><geometry><box><size>1.2 2.0 1.0</size></box></geometry></collision>
        <visual name="center"><pose>0 0 0.50 0 0 0</pose><geometry><box><size>1.2 2.0 1.0</size></box></geometry></visual>
        <collision name="north"><pose>0 5.9 0.50 0 0 0</pose><geometry><box><size>16 0.2 1</size></box></geometry></collision>
        <visual name="north"><pose>0 5.9 0.50 0 0 0</pose><geometry><box><size>16 0.2 1</size></box></geometry></visual>
        <collision name="south"><pose>0 -5.9 0.50 0 0 0</pose><geometry><box><size>16 0.2 1</size></box></geometry></collision>
        <visual name="south"><pose>0 -5.9 0.50 0 0 0</pose><geometry><box><size>16 0.2 1</size></box></geometry></visual>
        <collision name="east"><pose>7.9 0 0.50 0 0 0</pose><geometry><box><size>0.2 12 1</size></box></geometry></collision>
        <visual name="east"><pose>7.9 0 0.50 0 0 0</pose><geometry><box><size>0.2 12 1</size></box></geometry></visual>
        <collision name="west"><pose>-7.9 0 0.50 0 0 0</pose><geometry><box><size>0.2 12 1</size></box></geometry></collision>
        <visual name="west"><pose>-7.9 0 0.50 0 0 0</pose><geometry><box><size>0.2 12 1</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
