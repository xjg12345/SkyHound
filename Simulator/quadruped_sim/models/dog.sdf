<sdf version="1.6">
  <model name="dog1">
    <link name="chassis">
      <inertial><pose>0 0 0.13 0 0 0</pose><mass>8</mass><inertia><ixx>0.15</ixx><iyy>0.27</iyy><izz>0.32</izz></inertia></inertial>
      <collision name="body"><pose>0 0 0.13 0 0 0</pose><geometry><box><size>0.60 0.36 0.26</size></box></geometry><surface><friction><ode><mu>0.03</mu><mu2>0.03</mu2></ode></friction></surface></collision>
      <visual name="body"><pose>0 0 0.13 0 0 0</pose><geometry><box><size>0.60 0.36 0.26</size></box></geometry><material><ambient>0.13 0.38 0.75 1</ambient><diffuse>0.13 0.38 0.75 1</diffuse></material></visual>
      <sensor name="laser" type="ray">
        <pose>0 0 0.32 0 0 0</pose><always_on>true</always_on><update_rate>15</update_rate>
        <ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan>
          <range><min>0.06</min><max>8.0</max><resolution>0.01</resolution></range></ray>
        <plugin name="laser_ros" filename="libgazebo_ros_laser.so"><robotNamespace>/dog1</robotNamespace><topicName>scan</topicName><frameName>dog1/laser_link</frameName></plugin>
      </sensor>
      <sensor name="contacts" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate><contact><collision>body</collision></contact>
        <plugin name="contacts_ros" filename="libgazebo_ros_bumper.so"><robotNamespace>/dog1</robotNamespace><bumperTopicName>contacts</bumperTopicName><frameName>world</frameName></plugin>
      </sensor>
    </link>
    <plugin name="proxy_drive" filename="libquadruped_proxy.so"><robotNamespace>dog1</robotNamespace></plugin>
  </model>
</sdf>
