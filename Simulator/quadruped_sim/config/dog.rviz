Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Map
      Name: Static map
      Enabled: true
      Topic: /dog_map
    - Class: rviz/Map
      Name: Local costmap
      Enabled: true
      Alpha: 0.45
      Color Scheme: costmap
      Topic: /dog1/move_base/local_costmap/costmap
    - Class: rviz/LaserScan
      Name: Laser
      Enabled: true
      Topic: /dog1/scan
      Size (m): 0.035
    - Class: rviz/Path
      Name: Global path
      Enabled: true
      Topic: /dog1/move_base/NavfnROS/plan
    - Class: rviz/Path
      Name: Local path
      Enabled: true
      Topic: /dog1/move_base/DWAPlannerROS/local_plan
    - Class: rviz/TF
      Name: Dog frames
      Enabled: true
  Global Options:
    Fixed Frame: dog_map
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetGoal
      Topic: /dog1/move_base_simple/goal
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Scale: 40
