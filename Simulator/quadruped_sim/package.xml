<?xml version="1.0"?>
<package format="2">
  <name>prometheus_quadruped_sim</name>
  <version>0.1.0</version>
  <description>Single and four-agent ground navigation for Gazebo Classic.</description>
  <maintainer email="maintainers@example.org">Prometheus contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>gazebo_dev</build_depend>
  <build_depend>python3-setuptools</build_depend>
  <depend>geometry_msgs</depend>
  <depend>costmap_2d</depend>
  <depend>nav_core</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>move_base_msgs</exec_depend>
  <exec_depend>navfn</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>rosnode</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <export>
    <nav_core plugin="${prefix}/local_planner_plugin.xml"/>
  </export>
</package>
